{
  "name": "dymloader",
  "productName": "dymloader",
  "version": "0.1.0",
  "description": "DyMLoader",
  "scripts": {
    "start": "tsc && electron-forge start",
    "win": "tsc && electron-builder -w",
    "release": "tsc && electron-builder -w -p \"onTagOrDraft\""
  },
  "build": {
    "appId": "saito.dymloader",
    "extraResources": [
      {
        "from": "pyscript/",
        "to": "pyscript/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "modules/",
        "to": "modules/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "data/",
        "to": "data/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "ts_src/",
        "to": "ts_src/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "publish": [
        "github"
      ],
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^22.13.10",
    "electron": "32.0.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "keywords": [],
  "author": {
    "name": "AlexandreSaito",
    "email": "75994293+AlexandreSaito@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.4",
    "electron-window-state": "^5.0.3"
  }
}
